# mini-photoflow monolith: environment variables.
#
# Not loaded automatically: every variable has the default shown in monolith/main.go, and
# monolith/docker-compose.yml sets its own values. Use this file to run the app on your host:
#   cp monolith/.env.example monolith/.env
#   set -a; . monolith/.env; set +a
#   go run ./monolith
# Values are local dev defaults; never reuse them anywhere real.

# docker compose -f monolith/docker-compose.yml publishes Postgres on 127.0.0.1:55432
# (inside compose the app uses postgres://photo:photo@postgres:5432/photo).
DATABASE_URL=postgres://photo:photo@localhost:55432/photo

# HS256 key for the JWTs.
JWT_SECRET=dev-secret-change-me

# MinIO (images). ENDPOINT is how the app uploads (inside compose: minio:9000). PUBLIC_ENDPOINT is the
# host name put into the signed image URLs, so it must be reachable from the API client's machine.
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=photos

# ---------------------------------------------------------------- tests
# Contract tests (tests/contract) run against whatever answers here:
#   BASE_URL=http://localhost:8080 go test -count=1 ./tests/contract/...
BASE_URL=http://localhost:8080

# Optional: feed paging test with posts sharing one created_at; skipped when unset.
#   TEST_DATABASE_URL=postgres://photo:photo@localhost:55432/photo go test ./monolith/feed/...
