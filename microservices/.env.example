# mini-photoflow microservices: environment variables.
#
# docker compose reads microservices/.env for interpolation, but only FEED_MODE is used that way,
# so copying this file to microservices/.env is enough to choose the feed mode. Every other value
# is set inside microservices/docker-compose.yml. The rest is for running a service on your host:
#   cp microservices/.env.example microservices/.env
#   set -a; . microservices/.env; set +a
#   go run ./microservices/gateway
# Each service needs its own DATABASE_URL and GRPC_ADDR (see "Per service"), so export one
# service's block at a time, or use compose. Values are local dev defaults; never reuse them elsewhere.

# Feed step 1 (sync gRPC) or step 2 (read model fed by NATS events).
# Changing it needs `docker compose -f microservices/docker-compose.yml down -v` first:
# the read model is not backfilled.
FEED_MODE=sync

# HS256 key for the JWTs. The gateway and auth must use the same value.
JWT_SECRET=dev-secret-change-me

# Where the services find each other. Defaults are for processes on one host;
# inside compose they are auth:9001, post:9002, social:9003 and feed:9004.
AUTH_ADDR=localhost:9001
POST_ADDR=localhost:9002
SOCIAL_ADDR=localhost:9003
FEED_ADDR=localhost:9004

# NATS carries the events from post and social to feed. Compose does not publish its port, so on
# the host start your own broker: docker run --rm -d -p 4222:4222 nats:2.10-alpine
# If unset in post or social, no events are published; feed (event mode) falls back to localhost:4222.
NATS_URL=nats://localhost:4222

# MinIO. Used by post (uploads) and by feed in event mode (signs image URLs from the stored key).
# ENDPOINT is how post uploads (inside compose: minio:9000). PUBLIC_ENDPOINT is the host name put
# into the signed image URLs, so it must be reachable from the API client's machine.
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=photos

# ---------------------------------------------------------------- per service
# Postgres is published on 127.0.0.1:55433. Each role can connect to its own database only.
# Use ONE block at a time:
#   gateway  no database and no GRPC_ADDR; it listens on :8080
#   auth     DATABASE_URL=postgres://auth:auth@localhost:55433/auth        GRPC_ADDR=:9001
#   post     DATABASE_URL=postgres://post:post@localhost:55433/post        GRPC_ADDR=:9002
#   social   DATABASE_URL=postgres://social:social@localhost:55433/social  GRPC_ADDR=:9003
#   feed     DATABASE_URL=postgres://feed:feed@localhost:55433/feed        GRPC_ADDR=:9004   (event mode only)

# ---------------------------------------------------------------- tests
# Contract tests (tests/contract) run against whatever answers here:
#   BASE_URL=http://localhost:8080 go test -count=1 ./tests/contract/...
BASE_URL=http://localhost:8080

# Optional tests; each is skipped when its variable is unset.
#   feed read model:  TEST_DATABASE_URL=postgres://feed:feed@localhost:55433/feed go test ./microservices/feed/...
#   events on a real broker:  TEST_NATS_URL=nats://localhost:4222 go test ./internal/events/...
